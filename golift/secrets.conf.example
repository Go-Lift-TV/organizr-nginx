# Copy this file to secrets.conf (same folder) and edit it.
# secrets.conf is git-ignored; it holds base64 basic-auth credentials that
# nginx injects into proxied requests. These are `set` variables because this
# folder is included inside the main domain's server block.
#
# Generate values with:  echo -n 'username:password' | base64

# SecuritySpy: one web-server user per Organizr group. The $group ->
# $secspybase64_password map in site-confs/00-custom.conf picks one of these.
set $secspybase64       cGxhY2Vob2xkZXI=;   # org_user (viewing only)
set $secspybase64_power cGxhY2Vob2xkZXI=;   # org_poweruser
set $secspybase64_super cGxhY2Vob2xkZXI=;   # org_superuser
set $secspybase64_coadm cGxhY2Vob2xkZXI=;   # org_coadmin
set $secspybase64_admin cGxhY2Vob2xkZXI=;   # org_admin (full access)
