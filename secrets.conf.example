# Copy this file to secrets.conf (same folder) and edit it.
# secrets.conf is git-ignored; it holds values specific to your deployment.
# It is included at the http level from nginx.conf, so use map (not set).

# Your apex domain. Used for Organizr login redirects and CSP frame-ancestors
# on subdomain vhosts (see site-confs/unifi-controller.conf, yourls.conf).
map $host $maindomain {
    default example.com;
}
